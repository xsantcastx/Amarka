rules_version = '2';

// Firebase Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // JWT custom claim only — mirrors the Firestore rules change.
      // Claims are kept in sync by the onUserRoleChanged Cloud Function trigger.
      return isAuthenticated() && request.auth.token.role == 'admin';
    }
    
    function isValidImage() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < 10 * 1024 * 1024; // 10MB max (matches frontend validation)
    }
    
    function isValidVideo() {
      return request.resource.contentType.matches('video/.*') &&
             request.resource.size < 100 * 1024 * 1024; // 100MB max for videos
    }
    
    // Product images - Admin can write, everyone can read
    // Supports both cover images and gallery images
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (isValidImage() || isValidVideo());
      allow delete: if isAdmin();
    }
    
    // Gallery images - Admin can write, everyone can read
    // Updated to match single-level path: gallery/{imageName}
    match /gallery/{imageName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }
    
    // Legacy gallery with category path (kept for backward compatibility)
    match /gallery/{category}/{imageName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }
    
    // Hero images - Admin can write, everyone can read
    match /hero-images/{imageName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }
    
    // Service images - Admin can write, everyone can read
    match /services/{imageName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }
    
    // Settings images (OG images, logos, etc.) - Admin can write, everyone can read
    match /settings/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Collection hero images - Admin can write, everyone can read
    match /collections/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Customer customization uploads (logos/designs)
    match /customizations/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin()) && isValidImage();
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }
    
    // User profile images - Owner and admin only (not public, to protect PII)
    match /users/{userId}/{imageName} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() &&
                     (request.auth.uid == userId || isAdmin()) &&
                     isValidImage() &&
                     imageName.matches('^[a-zA-Z0-9._-]{1,200}$');
      allow delete: if isAuthenticated() &&
                      (request.auth.uid == userId || isAdmin());
    }
    
    // Public lead-form uploads (enquiry & trade briefs).
    // Anonymous submitters may write (size-capped, image/pdf/vector types);
    // only admins can read or delete. Referenced from Firestore lead docs.
    function isLeadUpload(fileName) {
      return request.resource.size > 0 && request.resource.size <= 20 * 1024 * 1024 &&
        fileName.matches('(?i)^[a-zA-Z0-9._-]+[.](pdf|ai|dwg|jpg|jpeg|png|svg)$') &&
        request.resource.contentType.matches('^(image/(jpeg|png|svg[+]xml|vnd[.]dwg|x-dwg)|application/(pdf|postscript|illustrator|acad|x-acad|dwg|x-dwg|octet-stream))$');
    }

    match /private/enquiries/{fileName} {
      allow create: if isLeadUpload(fileName);
      allow read, delete: if isAdmin();
    }

    match /private/trade-applications/{fileName} {
      allow create: if isLeadUpload(fileName);
      allow read, delete: if isAdmin();
    }

    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
